# ============================================================
# Agent Ranger 2 — Environment Variables
# Copy to .env (local dev) or set in Vercel Dashboard (production)
# ============================================================

# ── Anthropic Claude API (REQUIRED) ─────────────────────────
# Server-side only — NEVER use VITE_ prefix (would expose to browser)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Claude Model & cost controls (server-side, optional) ────
# ทุกค่ากำหนดฝั่ง server (api/anthropic.js, api/guard.js) — browser เปลี่ยนไม่ได้
# ห้ามตั้ง VITE_ANTHROPIC_API_KEY / VITE_CLAUDE_MODEL (โค้ดเลิกใช้แล้ว และ VITE_ จะฝังคีย์ลง browser)
# แชทของ Ranger (เปลี่ยนเป็น claude-sonnet-5-5 ถ้าต้องการคุณภาพสูงขึ้น)
CLAUDE_MODEL=claude-haiku-5-5
# low | medium | high | none
CLAUDE_EFFORT=low
CHAT_MAX_TOKENS=4096
# 0 = ปิด web search ($10 ต่อ 1,000 ครั้ง)
WEB_SEARCH_MAX_USES=2
# ข้อความต่อ IP ต่อชั่วโมง (0 = ไม่จำกัด)
CHAT_RATE_LIMIT=40
# false = ปิดตัวตรวจ AI ทันที ไม่ต้องแก้โค้ด
GUARD_AI_ENABLED=true
GUARD_MODEL=claude-haiku-5-5
GUARD_RATE_LIMIT=120
# โดเมนเพิ่มเติมที่อนุญาต (โดเมนของ deployment เองผ่านอยู่แล้ว)
# ALLOWED_ORIGINS=https://your-domain.com

# ── Neon PostgreSQL (REQUIRED) ───────────────────────────────
# ใช้ VITE_ prefix เพื่อให้ browser client ของ Neon ใช้ได้
VITE_DATABASE_URL=postgresql://neondb_owner:npg_xxxxx@ep-xxxxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# ── ElevenLabs TTS/STT (OPTIONAL) ────────────────────────────
# Server-side only — inject ผ่าน serverless function
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── NOTE FOR VERCEL DEPLOY ────────────────────────────────────
# ใน Vercel Dashboard → Settings → Environment Variables
# เพิ่ม: ANTHROPIC_API_KEY, VITE_DATABASE_URL, ELEVENLABS_API_KEY (+ ค่า optional ด้านบน)
# ไม่ต้องใส่ VITE_ prefix สำหรับ ANTHROPIC_API_KEY และ ELEVENLABS_API_KEY
# (ใช้ผ่าน serverless functions ใน /api/ folder)
