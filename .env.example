# ============================================================
# Agent Ranger 2 — Environment Variables
# Copy to .env (local dev) or set in Vercel Dashboard (production)
# ============================================================

# ── Anthropic Claude API (REQUIRED) ─────────────────────────
# Server-side only — NEVER use VITE_ prefix (would expose to browser)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Claude Model & cost controls (server-side, optional) ────
# ทุกค่ากำหนดฝั่ง server (api/anthropic.js, api/guard.js) — browser เปลี่ยนไม่ได้
# ห้ามตั้ง VITE_ANTHROPIC_API_KEY / VITE_CLAUDE_MODEL (โค้ดเลิกใช้แล้ว และ VITE_ จะฝังคีย์ลง browser)
# แชทของ Ranger — ใช้ Sonnet มาตลอด (Haiku ตอบคุณภาพไม่พอ)
CLAUDE_MODEL=claude-sonnet-4-6
# low | medium | high | none (none = ไม่ส่ง effort เหมือนเดิม)
CLAUDE_EFFORT=none
CHAT_MAX_TOKENS=4096
# ค้นเว็บได้กี่ครั้งต่อข้อความ — 2 (ค่าเริ่มต้น), 0 = ปิด; ค้นเฉพาะเรื่องที่ต้องใช้ข้อมูลใหม่ และแนบที่มาจริงท้ายคำตอบ
WEB_SEARCH_MAX_USES=2
# เครดิตที่หักเพิ่มเมื่อข้อความนั้นค้นเว็บจริง (ต้นทุนสูงกว่าข้อความปกติ)
SEARCH_EXTRA_CREDITS=2
# ข้อความต่อ IP ต่อชั่วโมง (0 = ไม่จำกัด)
CHAT_RATE_LIMIT=40
# false = ปิดตัวตรวจ AI ทันที ไม่ต้องแก้โค้ด
GUARD_AI_ENABLED=true
GUARD_MODEL=claude-haiku-5-5
GUARD_RATE_LIMIT=120
# ── เครดิตรายวัน (รีเซ็ตเที่ยงคืนเวลาไทย) ──
# เครดิตต่อผู้ใช้ต่อวัน
DAILY_CREDITS=30
# จำนวนผู้ใช้สูงสุดต่อวันทั้งระบบ
# แนบไฟล์ได้กี่ไฟล์ต่อคนต่อวัน (รูปหรือไฟล์ข้อความ ชิ้นละ 1) — 0 = ไม่จำกัด
DAILY_FILES=3
DAILY_USER_CAP=20
# IP เดียวเปิดผู้ใช้ใหม่ได้กี่คนต่อวัน
IP_DAILY_USER_LIMIT=5
# false = ปิดระบบเครดิต
CREDITS_ENABLED=true
# โดเมนเพิ่มเติมที่อนุญาต (โดเมนของ deployment เองผ่านอยู่แล้ว)
# ALLOWED_ORIGINS=https://your-domain.com

# ── Neon PostgreSQL (REQUIRED) ───────────────────────────────
# Server-side only — ห้ามใช้ VITE_ prefix (จะถูกฝังลง browser ให้ทุกคนเห็น)
# browser เข้าถึงข้อมูลผ่าน /api/brands, /api/messages เท่านั้น
DATABASE_URL=postgresql://neondb_owner:npg_xxxxx@ep-xxxxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# ── ElevenLabs TTS/STT (OPTIONAL) ────────────────────────────
# Server-side only — inject ผ่าน serverless function
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── NOTE FOR VERCEL DEPLOY ────────────────────────────────────
# ใน Vercel Dashboard → Settings → Environment Variables
# เพิ่ม: ANTHROPIC_API_KEY, DATABASE_URL, ELEVENLABS_API_KEY (+ ค่า optional ด้านบน)
# ไม่ต้องใส่ VITE_ prefix สำหรับ ANTHROPIC_API_KEY และ ELEVENLABS_API_KEY
# (ใช้ผ่าน serverless functions ใน /api/ folder)
